# Copy to .env and fill in. python-dotenv loads this automatically; never commit
# the real .env (it's in .gitignore).

# --- Required for etl/extract_and_tag.py ---
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest

# --- Required for etl/ingest_macro_indicators.py (FRED series) ---
# Free key, instant signup: https://fred.stlouisfed.org/docs/api/api_key.html
FRED_API_KEY=

# --- Storage backend: duckdb (default, no GCP needed) or bigquery ---
DB_BACKEND=duckdb
LOCAL_DB_PATH=data/warehouse.duckdb

# --- Only used when DB_BACKEND=bigquery ---
GOOGLE_CLOUD_PROJECT=
BQ_DATASET=mp_commodities_corr

# --- Optional: uploads raw article JSON to GCS in addition to data/raw/ ---
GCS_RAW_BUCKET=
