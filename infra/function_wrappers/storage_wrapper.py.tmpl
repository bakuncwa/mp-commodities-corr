"""Functions Framework CloudEvent entry point for the Cloud Storage
object-finalize trigger — generated by build_function_packages.sh. Fires when
ingest_feeds.py's Cloud Function writes a new raw article JSON file.
"""
import functions_framework
from job import run_extraction


@functions_framework.cloud_event
def main(cloud_event):
    data = cloud_event.data
    bucket, name = data["bucket"], data["name"]
    # job.run_extraction() reads from local disk or GCS depending on GCS_RAW_BUCKET;
    # the CloudEvent's (bucket, name) tells it which object just landed.
    result = run_extraction(gcs_bucket=bucket, gcs_object=name)
    print(f"Extraction result for gs://{bucket}/{name}: {result}")
