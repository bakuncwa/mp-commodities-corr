"""Functions Framework HTTP entry point — generated by build_function_packages.sh.
Combines ingest_macro_indicators + ingest_market_data into one Cloud Function
behind one Cloud Scheduler job, purely to stay within Cloud Scheduler's 3
free-jobs-per-billing-account tier (see infra/scheduler.tf) — the two ETL
scripts themselves stay independent and separately runnable locally
(`make ingest-macro`, `make ingest-market`); this wrapper is deploy-only.
"""
import functions_framework
from job_macro import run_ingest as run_macro_ingest
from job_market import run_ingest as run_market_ingest


@functions_framework.http
def main(request):
    macro_result = run_macro_ingest()
    market_result = run_market_ingest()
    return {"macro": macro_result, "market": market_result}, 200
